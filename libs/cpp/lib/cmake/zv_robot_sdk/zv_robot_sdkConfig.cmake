include(CMakeFindDependencyMacro)
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "zv_robot_sdk 1.0.17 supports Linux only")
endif()
string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _zv_processor)
if(_zv_processor MATCHES "^(x86_64|amd64)$")
    set(ZV_ROBOT_SDK_ARCH x86_64)
elseif(_zv_processor MATCHES "^(aarch64|arm64)$")
    set(ZV_ROBOT_SDK_ARCH aarch64)
else()
    message(FATAL_ERROR "Unsupported zv_robot_sdk architecture: ${CMAKE_SYSTEM_PROCESSOR}")
endif()
get_filename_component(_zv_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(ZV_ROBOT_SDK_LIBRARY_DIR "${_zv_prefix}/lib/${ZV_ROBOT_SDK_ARCH}")
set(zv_robot_sdk_INCLUDE_DIRS "${_zv_prefix}/include")
set(zv_robot_sdk_VERSION "1.0.17")
foreach(_zv_library libzv_robot_sdk.so libddscxx.so libddsc.so)
    if(NOT EXISTS "${ZV_ROBOT_SDK_LIBRARY_DIR}/${_zv_library}")
        message(FATAL_ERROR "Missing SDK library: ${ZV_ROBOT_SDK_LIBRARY_DIR}/${_zv_library}")
    endif()
endforeach()
find_dependency(CURL REQUIRED)
find_dependency(Threads REQUIRED)
if(NOT TARGET zv_robot_sdk::zv_robot_sdk)
    add_library(zv_robot_sdk::zv_robot_sdk SHARED IMPORTED GLOBAL)
    set_target_properties(zv_robot_sdk::zv_robot_sdk PROPERTIES
        IMPORTED_LOCATION "${ZV_ROBOT_SDK_LIBRARY_DIR}/libzv_robot_sdk.so"
        INTERFACE_INCLUDE_DIRECTORIES
            "${_zv_prefix}/include;${_zv_prefix}/include/zv/idl/ros2;${_zv_prefix}/include/zv/idl/t3;${_zv_prefix}/include/zv/idl/t4;${_zv_prefix}/include/zv/robot/internal/idl;${_zv_prefix}/include/ddscxx"
    )
    set_property(TARGET zv_robot_sdk::zv_robot_sdk PROPERTY INTERFACE_LINK_LIBRARIES
        "${ZV_ROBOT_SDK_LIBRARY_DIR}/libddscxx.so;${ZV_ROBOT_SDK_LIBRARY_DIR}/libddsc.so;CURL::libcurl;Threads::Threads;${CMAKE_DL_LIBS}")
endif()
if(NOT TARGET zv_robot_sdk)
    add_library(zv_robot_sdk ALIAS zv_robot_sdk::zv_robot_sdk)
endif()
set(zv_robot_sdk_LIBRARIES zv_robot_sdk::zv_robot_sdk)
message(STATUS "zv_robot_sdk 1.0.17: ${ZV_ROBOT_SDK_ARCH} (${ZV_ROBOT_SDK_LIBRARY_DIR})")
